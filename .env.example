# ===== Telegram =====
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# (необов'язково) Chat ID, куди слати алерти за замовчуванням.
# Якщо порожньо — бот шле всім, хто натиснув /start.
TELEGRAM_CHAT_ID=

# ===== Налаштування сканера =====
# Котирувальна валюта (проти чого рахуємо ціну)
QUOTE=USDT

# Поріг спреду у відсотках для авто-алертів
MIN_SPREAD_PERCENT=1.0

# Верхній фільтр відсотка (відсікає аномальні/мертві ринки), 0 = без обмеження
MAX_SPREAD_PERCENT=50

# Інтервал сканування у секундах
SCAN_INTERVAL=60

# Скільки секунд тримати "тишу" по одному токену після алерта (анти-спам)
ALERT_COOLDOWN=900

# ===== Біржі =====
# CEX через ccxt (через кому). "all" = всі ринкові спот-біржі, які підтримує ccxt.
CEX_EXCHANGES=binance,bybit,okx,kucoin,gate,mexc,htx,bitget,kraken,coinbase

# Увімкнути DEX через DexScreener (true/false)
ENABLE_DEX=true

# ===== Токени для моніторингу (через кому) =====
# Порожньо = автоматично взяти топ-перетин ринків усіх увімкнених CEX.
TOKENS=BTC,ETH,SOL,XRP,DOGE,ADA,AVAX,LINK,MATIC,DOT,TRX,LTC,ARB,OP,APT,SUI,SEI,INJ,TIA,PEPE
