# ===== Telegram =====
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# (необов'язково) Chat ID, куди слати сигнали за замовчуванням.
# Якщо порожньо — бот шле всім, хто натиснув /start.
TELEGRAM_CHAT_ID=

# ===== Сканер =====
# Котирувальна валюта
QUOTE=USDT

# Поріг різниці DEX↔CEX у відсотках для авто-сигналів
MIN_SPREAD_PERCENT=3.0

# Верхній фільтр (відсікає аномалії), 0 = без обмеження
MAX_SPREAD_PERCENT=80

# Інтервал сканування, секунд
SCAN_INTERVAL=60

# Анти-спам: пауза по одному токену після сигналу, секунд
ALERT_COOLDOWN=900

# Мінімальна ліквідність DEX-пари (USD), щоб не ловити сміття. 0 = вимкнено
MIN_DEX_LIQUIDITY=10000

# ===== Оцінка успішності сигналу =====
# Через скільки секунд закривати відкритий сигнал як невдалий
SIGNAL_TTL=1800
# Сигнал = успішний, якщо різниця стиснулась нижче цієї частки від стартової
SUCCESS_CONVERGENCE=0.5

# ===== Біржі =====
# Тип ринку CEX: swap (ф'ючерси/безстрокові) або spot
MARKET_TYPE=swap

# CEX через ccxt (через кому). "all" = всі біржі, які підтримує ccxt.
CEX_EXCHANGES=binance,bybit,okx,kucoin,gate,mexc,bitget

# ===== Токени (через кому) =====
# Порожньо = авто-підбір найпоширеніших токенів серед CEX.
TOKENS=
